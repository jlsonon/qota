<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_obsidian">

    <!-- Top Action Bar for Floating HUD Trigger -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#151921">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QOTA • MOBILE DASHBOARD"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_toggle_hud"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="FLOATING HUD"
            android:textSize="11sp"
            android:backgroundTint="#2563EB"
            android:textColor="@color/white"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <!-- Full Dashboard WebView loading embedded assets -->
    <WebView
        android:id="@+id/webview_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
